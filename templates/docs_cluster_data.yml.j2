site:
  name: "{{ cluster_name }}"
  status: "{{ 'active' if (_cluster_report.kube_api_reachable | default(false)) else 'planned' }}"
  vip: "{{ talos_vip | default('') }}"
  subnet: "{{ talos_network_global.cluster_subnet | default('') }}"
  kubernetes_api: "https://{{ talos_vip | split('/') | first | default(hostvars[groups.talos_controlplane[0]].talos_ip) }}:6443"
  cni: "{{ cni | default('unknown') }}"
  talos_version: "{{ talos_facts.version | default('unknown') }}"
devices:
{% for host in groups.all | sort %}
  - "{{ host }}"
{% endfor %}
nodes:
{% for node in _cluster_report.nodes | default([], true) %}
  - name: "{{ node.name }}"
    roles: "{{ node.roles | default('worker') }}"
    internal_ip: "{{ node.internal_ip }}"
    status: "{{ node.status }}"
    version: "{{ node.version }}"
{% endfor %}
control_planes:
{% for host in groups.talos_controlplane | default([]) | sort %}
  - "{{ host }}"
{% endfor %}
workers:
{% for host in groups.talos_workers | default([]) | sort %}
  - "{{ host }}"
{% endfor %}
