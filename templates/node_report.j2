{# roles/talos/templates/node_report.j2 #}
{% set facts_maintenance = (talos_facts.machinestatus_stage | default('unknown') == 'maintenance') %}
{% set network_maintenance = talos_network_global.is_maintenance | default(true) %}

{% if facts_maintenance != network_maintenance %}
{% set report_state = "DIRTY — MAINTENANCE FLAGS DISAGREE" %}
**REPORT STATE: {{ report_state }}**
- From machinestatus: {{ facts_maintenance }}
- From network module: {{ network_maintenance }}
{% else %}
{% set report_state = "CLEAN" %}
{% endif %}

# Talos Node Report — {{ report_state }} — {{ inventory_hostname }}

> **Generated:** `{{ ansible_date_time.iso8601 }}`  
> **Talos Version:** `{{ talos_facts.version }}`  
> **Node Type:** `{{ node_type | capitalize }}`
{% if node_type == 'standalone' %}
> **Scheduler:** `Allowed on control plane` (single-node cluster)
{% endif %}  
> **Management IP:** `{{ talos_ip }}`  
{% if talos_network_global.vip %}
> **Cluster Name:** `{{ cluster_name }}`  
> **Cluster VIP:** `{{ talos_network_global.vip }}`  
> **Cluster Subnet:** `{{ talos_network_global.cluster_subnet }}`
{% else %}
> **Cluster VIP:** *none*  
> **Cluster Subnet:** `{{ talos_network_global.cluster_subnet | default('n/a') }}`
{% endif %}

